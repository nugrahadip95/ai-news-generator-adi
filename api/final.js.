
export default async function handler(req, res) {
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "POST, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (req.method === "OPTIONS") {
    return res.status(200).end();
  }

  if (req.method !== "POST") {
    return res.status(405).json({
      error: "Gunakan metode POST."
    });
  }

  const apiKey = process.env.GEMINI_API_KEY;

  if (!apiKey) {
    return res.status(500).json({
      error: "GEMINI_API_KEY belum diatur di Vercel."
    });
  }

  try {
    const input = req.body;

    if (!input || !input.source || !input.source.trim()) {
      return res.status(400).json({
        error: "Bahan mentah berita wajib diisi."
      });
    }

    const prompt = `
Anda adalah editor berita resmi Bawaslu Kabupaten Gorontalo.
Susun berita final berbahasa Indonesia berdasarkan bahan sumber.

JENIS BERITA: ${input.type || ""}
SUBJEK: ${input.subject || ""}
POLA JUDUL: ${input.titleStyle || ""}
POLA LEAD: ${input.leadStyle || ""}
PANJANG BERITA: ${input.length || "standar"}

JUDUL PILIHAN:
${input.selectedTitle || input.title || ""}

ANGLE PILIHAN:
${input.selectedAngle || input.angle || ""}

BAHAN SUMBER:
${input.source}

ATURAN WAJIB:
1. Jangan mengarang fakta, nama, jabatan, tanggal, tempat,
   angka, peristiwa, atau informasi yang tidak ada di sumber.
2. Kutipan langsung hanya boleh disalin persis dari sumber.
3. Jangan mengubah parafrasa menjadi kutipan langsung.
4. Jika informasi penting tidak tersedia, jangan menebaknya.
5. Gunakan bahasa jurnalistik yang lugas, netral, dan profesional.
6. Hindari pengulangan, klaim berlebihan, dan bahasa promosi.
7. Pertahankan substansi serta konteks sumber.
8. Jangan menambahkan fakta dari pengetahuan umum.

KELUARAN:
Kembalikan hanya JSON valid dengan struktur:
{
  "title": "Judul berita",
  "lead": "Paragraf pembuka",
  "body": "Isi berita lengkap dengan paragraf yang dipisahkan baris baru",
  "closing": "Paragraf penutup jika diperlukan",
  "verificationNotes": [
    "Informasi yang perlu diverifikasi sebelum publikasi"
  ]
}
`;

    const response = await fetch(
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-goog-api-key": apiKey
        },
        body: JSON.stringify({
          contents: [
            {
              parts: [{ text: prompt }]
            }
          ],
          generationConfig: {
            responseMimeType: "application/json",
            temperature: 0.3
          }
        })
      }
    );

    const result = await response.json();

    if (!response.ok) {
      return res.status(response.status).json({
        error: result.error?.message || "Permintaan Gemini gagal."
      });
    }

    const text = result.candidates?.[0]?.content?.parts
      ?.map(part => part.text || "")
      .join("");

    if (!text) {
      return res.status(502).json({
        error: "Gemini tidak menghasilkan berita."
      });
    }

    const data = JSON.parse(text);

    return res.status(200).json(data);

  } catch (error) {
    return res.status(500).json({
      error: error.message || "Terjadi kesalahan pada server."
    });
  }
}
